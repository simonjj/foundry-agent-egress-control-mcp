server {
    listen 8080;
    server_name _;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location / {
        proxy_pass https://${FOUNDRY_BACKEND_HOST}/api/projects/${FOUNDRY_PROJECT_NAME}/;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${FOUNDRY_BACKEND_HOST};

        proxy_set_header Host ${FOUNDRY_BACKEND_HOST};
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_set_header X-Client-Request-Id $http_x_ms_client_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 4m;
    }
}
