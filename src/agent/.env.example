APIM_FOUNDRY_PROJECT_ENDPOINT="https://<gateway>.azure-api.net/foundry"
APIM_SUBSCRIPTION_KEY="<generated-by-terraform>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5.4-mini"
MCP_SERVER_URL="https://<sandbox-port-host>/mcp"
MCP_AUTH_TOKEN="<generated-by-terraform>"
PLAYWRIGHT_CONNECTION_ID="/subscriptions/<subscription>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>/connections/playwright-automation"
ENABLE_INSTRUMENTATION="true"
ENABLE_SENSITIVE_DATA="true"
OTEL_TRACES_SAMPLER="always_on"
OTEL_METRIC_EXPORT_INTERVAL="10000"
